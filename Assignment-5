        "\n",
        "# Create 5-fold stratified cross-validation\n",
        "skf = StratifiedKFold(\n",
        "    n_splits=5,\n",
        "    shuffle=True,\n",
        "    random_state=42\n",
        ")\n",
        "\n",
        "# Create fresh models\n",
        "dt_cv = DecisionTreeClassifier(\n",
        "    max_depth=4,\n",
        "    random_state=42,\n",
        "    class_weight='balanced'\n",
        ")\n",
        "\n",
        "nb_cv = BernoulliNB()\n",
        "\n",
        "# Evaluate Decision Tree\n",
        "dt_scores = cross_val_score(\n",
        "    dt_cv, X, y,\n",
        "    cv=skf,\n",
        "    scoring='f1'\n",
        ")\n",
        "\n",
        "# Evaluate Naive Bayes\n",
        "nb_scores = cross_val_score(\n",
        "    nb_cv, X, y,\n",
        "    cv=skf,\n",
        "    scoring='f1'\n",
        ")\n",
        "\n",
        "# Print results\n",
        "print(\"Decision Tree F1 scores:\", dt_scores)\n",
        "print(\"Decision Tree Average F1:\", dt_scores.mean())\n",
        "\n",
        "print(\"\\nNaive Bayes F1 scores:\", nb_scores)\n",
        "print(\"Naive Bayes Average F1:\", nb_scores.mean())\n"
      ]
